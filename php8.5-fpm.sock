[www]
listen = /var/run/php/php8.5-fpm.sock   ; only once
listen.owner = www-data
listen.group = www-data
listen.mode = 0660

pm = dynamic
pm.max_children = 25
pm.start_servers = 2
pm.min_spare_servers = 2
pm.max_spare_servers = 6
pm.status_path = /status
pm.max_requests = 500

request_terminate_timeout = 300s
