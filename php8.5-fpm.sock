[www]
listen = /var/run/php/php8.5-fpm.sock
listen.owner = www-data
listen.group = www-data
listen.mode = 0660

listen = /var/run/php/php8.5-fpm.sock

pm = dynamic
pm.max_children = 50
pm.start_servers = 5
pm.min_spare_servers = 5
pm.max_spare_servers = 35

request_terminate_timeout = 120s

pm.status_path = /status
pm.max_requests = 500
